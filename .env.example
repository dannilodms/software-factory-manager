# Every variable of the system, with values that work in development as they
# are. Nothing here is a real secret.
#
# Task loads `.env` first and this file for what `.env` lacks, and passes the
# variables to Compose, so development runs without a `.env`. To change a
# value, write it in a `.env`.
#
# Staging has a value of its own for every name here, decided in
# apps/api/tools/environment/variables.go. A new name gets its decision there
# in the same change, or the publish to staging stops before it reaches the
# server.
# Rules: Configuration, Development and Secrets in CODING_STANDARDS.md.

# --- The PostgreSQL container (Compose) ---

# Port of the machine that reaches PostgreSQL.
POSTGRES_PORT=5432
# Password of the superuser, `postgres`. Only the tests use it, to create
# their temporary databases.
POSTGRES_PASSWORD=postgres
# Passwords of the two roles the container creates on its first start.
POSTGRES_MIGRATION_PASSWORD=migration
POSTGRES_API_PASSWORD=api

# --- The Caddy container (Compose) ---

# Port of the machine where Caddy serves the app, with the API under /api.
# APP_ORIGIN names it.
CADDY_PORT=80
# The address Caddy gives the certificate authorities for the account of a
# server, in staging (deploy/Caddyfile.staging). Empty, Caddy asks Let's
# Encrypt alone; with an address, it asks ZeroSSL when Let's Encrypt
# refuses. Development has no certificate and reads none.
ACME_EMAIL=

# --- The images of a server (deploy/compose.staging.yaml) ---

# The hash of the commit whose images a server runs: the tag of the images
# of the API, of Caddy with the built web app and of the seed, which the
# pipeline pushed. Development builds its own images and reads none.
COMMIT=

# --- The Garage container (Compose), the file storage of development ---

# Port of the machine that reaches the S3 API of Garage. FILE_STORAGE_URL
# names it. The browser reaches Garage through Caddy instead.
GARAGE_PORT=3900
# The secret the nodes of a Garage cluster share: 32 bytes in hexadecimal.
# Garage creates its bucket and its key from the FILE_STORAGE_ variables below.
GARAGE_RPC_SECRET=1723304fe95b72150df6ce12ff1aea3b0469f4e93c29c11614bbc65d41e16fef

# --- The Mailpit container (Compose), the e-mail server of development ---

# Port of the machine where Mailpit takes e-mail over SMTP. EMAIL_SMTP_ADDRESS
# names it.
MAILPIT_SMTP_PORT=1025
# Port of the machine where Mailpit shows the e-mail it took, at
# http://localhost:8025, and answers its API. The tests of the SMTP adapter
# read an e-mail back there.
MAILPIT_PORT=8025
# Where the browser opens Mailpit, as a scheme and a host. In development,
# Mailpit at MAILPIT_PORT, and nothing reads this. In staging, its host
# name, which Caddy serves (deploy/Caddyfile.staging).
MAILPIT_PUBLIC_URL=http://localhost:8025
# The bcrypt hash of the password of Mailpit, which Caddy asks the browser
# for in staging, for the user `maintainer`; `caddy hash-password` writes
# one. Empty in development, where Mailpit has no password. A variables file
# that Compose reads holds it in single quotes, because Compose takes a
# dollar sign there for the start of a variable.
MAILPIT_PASSWORD_HASH=

# --- The Dex container (Compose), the local login provider, development only ---

# Port of the machine where Dex answers, and the port its issuer names:
# LOCAL_LOGIN_PROVIDER_ISSUER_URL repeats it. The browser and the API both
# reach Dex there. Its client and the path it sends a person back to are the
# LOCAL_LOGIN_PROVIDER_ variables below.
DEX_PORT=5556

# --- The River panel container (Compose), development only ---

# Port of the machine where the River panel shows the jobs. It reads the
# development database as the API role.
RIVER_PANEL_PORT=8081

# --- Vite, which serves the app in development ---

# The interface Vite listens on, at port 5173, where Caddy reaches it. Docker
# Desktop reaches 127.0.0.1 of the machine. Docker Engine on Linux does not:
# there, write 0.0.0.0 here and as the host of API_LISTEN_ADDRESS.
WEB_LISTEN_HOST=127.0.0.1

# --- The API binary ---

# Where the API listens, as host:port. An empty host is every interface. In
# development Caddy forwards /api to port 8080 of the machine.
API_LISTEN_ADDRESS=127.0.0.1:8080
# How long the requests in flight have to finish once the API is told to stop.
# Default: 20s.
SHUTDOWN_DRAIN_DEADLINE=20s
# The lowest level the binary logs: debug, info, warn or error. Default: info.
LOG_LEVEL=info
# Base URL of the OTLP/HTTP receiver the traces are exported to, such as
# http://localhost:4318. Empty exports nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Connection of the API role, which reads and writes rows. Required by the API.
DATABASE_URL=postgres://api:api@localhost:5432/software_factory?sslmode=disable
# Connection of the migration role, which owns the tables. Required by `migrate`.
MIGRATION_DATABASE_URL=postgres://migration:migration@localhost:5432/software_factory?sslmode=disable
# The most connections the pool of the API opens. Default: 10.
DATABASE_POOL_MAX_SIZE=10
# How long one statement may run. Default: 30s.
DATABASE_STATEMENT_TIMEOUT=30s
# How long a transaction may sit idle. Default: 1m.
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=1m
# How long the check of a part may take, readiness included. Default: 2s.
HEALTH_CHECK_TIMEOUT=2s
# The address people open the app at: a scheme, a host and maybe a port, with
# nothing after them. Required by the API, whose cookie of the session goes
# over HTTPS only when this is https, and which refuses a request that changes
# state with that cookie from any other origin, and by `issue-setup-code`,
# which prints the address of the setup from it. In development it is Caddy,
# at CADDY_PORT.
APP_ORIGIN=http://localhost
# The file storage, reached through the S3 API. Required by the API.
# Where the API reaches it. In development, Garage at GARAGE_PORT.
FILE_STORAGE_URL=http://localhost:3900
# Where the browser reaches it, the host name a signed URL is signed for. In
# development, the host name of Garage in the Caddyfile, at CADDY_PORT.
FILE_STORAGE_PUBLIC_URL=http://files.localhost
# The region the storage signs with, and the one private bucket of the files.
FILE_STORAGE_REGION=garage
FILE_STORAGE_BUCKET=software-factory-files
# The key the API signs with. In development, Garage creates it as it is here.
FILE_STORAGE_ACCESS_KEY_ID=GK94b515f6d327dced13523683
FILE_STORAGE_SECRET_ACCESS_KEY=7d28ea6944a2b7950e7638be3138dcaaa3b1fc4f6ab7ac062ea087c6b0d8b329

# --- The login ---

# The key the login codes are computed with: at least 32 bytes, written in
# hexadecimal (`openssl rand -hex 32` writes one). Required by `worker`, which
# writes the code in its e-mail, and by the API, which checks the code typed.
# Changing it ends only the codes not yet used.
LOGIN_CODE_KEY=6c6f67696e2d636f64652d6b65792d6f662d646576656c6f706d656e742d3031
# The local login provider, an OpenID Connect provider for development and
# the tests: in development, the Dex container at DEX_PORT. Set all five to
# turn it on, or leave all five empty to turn it off; the API names it in a
# line of its log when it starts. Its key names it in its paths
# (/api/session/login_providers/<key>/...), in its provider links and in the
# audit log: lowercase letters, digits and underscores. The display name is
# what the login screen shows on its button. The client is the one the
# configuration of Dex in compose.yaml declares, which reads these values
# too; the secret is fictitious.
LOCAL_LOGIN_PROVIDER_KEY=local
LOCAL_LOGIN_PROVIDER_DISPLAY_NAME="Local login provider"
LOCAL_LOGIN_PROVIDER_ISSUER_URL=http://localhost:5556
LOCAL_LOGIN_PROVIDER_CLIENT_ID=software-factory-manager
LOCAL_LOGIN_PROVIDER_CLIENT_SECRET=local-login-provider-secret-of-development

# --- The seed binary ---

# The mailbox the e-mail addresses of the seed are derived from: the
# administrator is the address tagged +admin (seed+admin@fabrica.example), the
# developer the one tagged +developer. Required by `seed`. The default is
# fictitious, and the local login provider lists its people. Staging keeps
# it: the worker sends every e-mail there to Mailpit, which delivers none.
SEED_MAILBOX=seed@fabrica.example

# --- The worker command of the API binary ---

# The most jobs each queue runs at once in one worker process. Defaults: 10
# and 2.
WORKER_LIGHT_QUEUE_MAX_JOBS=10
WORKER_HEAVY_QUEUE_MAX_JOBS=2
# How long the running jobs have to finish once the worker is told to stop,
# before they are cancelled and left for the next worker. Default: 20s.
WORKER_SHUTDOWN_DEADLINE=20s
# What the worker sends e-mail through: smtp, which development, the tests
# and staging point at Mailpit, or resend, the API of Resend, in production.
# Required by `worker`.
EMAIL_SENDER=smtp
# The SMTP server, as host:port. Required by `worker` when EMAIL_SENDER is
# smtp. In development, Mailpit at MAILPIT_SMTP_PORT.
EMAIL_SMTP_ADDRESS=localhost:1025
# The address and the name every e-mail is sent from. Required by `worker`.
# Both are fictitious here.
EMAIL_FROM_ADDRESS=no-reply@fabrica.example
EMAIL_FROM_NAME="My Software Factory Manager"

# --- Resend, the e-mail of production ---

# The key of the Resend account. Required by `worker` when EMAIL_SENDER is
# resend. Empty in development, which sends nothing through Resend.
RESEND_API_KEY=
# The signing secret of the webhook that reports a bounce, as Resend shows
# it: whsec_ followed by the key in base64. When it is set, the API takes the
# notices at /api/resend/bounces; empty, that path is unknown.
RESEND_WEBHOOK_SECRET=

# --- The Go tests ---

# Connection of a superuser. Each test that needs PostgreSQL creates its own
# temporary database with it and removes it at the end.
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
# A key of Resend for the tests of its adapter against Resend itself, which
# send to Resend's test addresses. Empty, they skip: only the scheduled
# workflow resend.yml gives it, from a secret, never a pull request.
RESEND_TEST_API_KEY=
